# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas free tier works well).
MONGODB_URI=mongodb://127.0.0.1:27017/fabricnest

# ─── Auth ────────────────────────────────────────────────────────────────────
# At least 32 random characters. `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string
# Days a session cookie stays valid.
AUTH_SESSION_DAYS=7

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin, used for Stripe redirect URLs and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run checkout in "test gateway" mode, which
# simulates a paid session server-side so the full order flow can be exercised
# without Stripe. Set both keys for real (test-mode) Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currency for Checkout Sessions. Stripe test mode supports inr.
PAYMENT_CURRENCY=inr

# ─── AI (Google Gemini, free tier) ───────────────────────────────────────────
# Optional. Without a key the rules-based intent parser and assistant still
# work; with a key, query understanding and assistant copy are upgraded.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Email (password reset) ──────────────────────────────────────────────────
# Optional SMTP. When unset, reset links are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FabricNest <no-reply@fabricnest.app>"

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@fabricnest.app
SEED_ADMIN_PASSWORD=admin12345
